#!/bin/bash
# OCI prestart hook for RHSB-2026-012.
#
# Removes the compromised eMudhra and AAA root CAs from a new container's trust
# stores. Only the container's writable layer changes; the image does not.
# The hook always exits 0, so it never blocks a container from starting.

LOG=${RHSB_LOG:-/var/log/rhsb-2026-012-hook.log}

# Last base64 line (the signature) of each root. It is unique to the certificate
# and appears in every PEM copy of it.
BAD=$'rvmsmfqPr5E7ecwXb6kXA5LTFd6rjwTuV3sCMQC9w6ZSbVq1mveMO6dKFziOzClT
rv4jJyV01QaxGn0HErZ8gjHkngqe+tcFogIxAPTdW0hBmrGjhxBWdv9mZNdVFiJ4
l2D4kF501KKaU73yqWjgom7C12yxow+ev+to51byrvLjKzg6CYG1a4XXvi3tPxq3
CUfvO6wIBHxcmbHtRwfSAjEAnbpV/KlK6O3t5nYBQnvI+GDZjVGLVTv7jHvrZQnD'

# Same roots, matched by subject name inside binary Java keystores.
BAD_JAVA='emSign Root TLS CA - G3|emSign ECC Root CA - G3|emSign Root CS CA - G3|AAA Certificate Services'

log()     { echo "$(date -u +%FT%TZ) ${id:0:12} $*" >> "$LOG"; }
has_bad() { grep -qF -- "$BAD" "$1"; }
# A regular file whose real path stays inside the container. This stops an
# image symlink such as /etc/ssl/cert.pem -> /etc/shadow from reaching the host.
inside()  { [ -f "$1" ] && [ ! -L "$1" ] && [[ $(realpath "$1") == "$root"/* ]]; }

# Print a PEM file without the certificates that end in a bad signature line.
drop_bad() {
  awk -v bad="$BAD" '
    BEGIN       { split(bad, b, "\n"); for (i in b) skip[b[i]] }
    /^-----BEGIN/ { pem = ""; keep = 1; in_pem = 1 }
    in_pem      { pem = pem $0 "\n"; line = $0; sub(/\r$/, "", line)
                  if (line in skip) keep = 0
                  if (/^-----END/) { in_pem = 0; if (keep) printf "%s", pem }
                  next }
                { print }' "$1"
}

# Follow a symlink inside the container: absolute targets are relative to the
# container root, not the host.
resolve() {
  local p=$1 n t
  for n in 1 2 3 4 5; do
    [ -L "$p" ] || break
    t=$(readlink "$p")
    case $t in /*) p=.$t ;; *) p=$(dirname "$p")/$t ;; esac
  done
  echo "$p"
}

# The OCI state on stdin names the bundle; its config.json names the rootfs.
state=$(tr -d '\n')
id=$(grep -o '"id": *"[^"]*"' <<<"$state" | cut -d'"' -f4)
bundle=$(grep -o '"bundle": *"[^"]*"' <<<"$state" | cut -d'"' -f4)
root=$(tr -d '\n' < "$bundle/config.json" 2>/dev/null |
       grep -o '"root": *{[^}]*}' | grep -o '"path": *"[^"]*"' | cut -d'"' -f4)
[[ $root == /* ]] || root=$bundle/$root
root=$(realpath -e "$root" 2>/dev/null) && cd "$root" || exit 0

# PEM bundles, relative to the container root (the working directory). The
# globs expand here, after the cd.
BUNDLES=(
  etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem        # RHEL, UBI
  etc/pki/ca-trust/extracted/openssl/ca-bundle.trust.crt  # RHEL, UBI
  etc/ssl/certs/ca-certificates.crt                       # Debian, Ubuntu, Alpine
  etc/ssl/cert.pem                                        # Alpine
  etc/ssl/ca-bundle.pem                                   # SUSE
  var/lib/ca-certificates/ca-bundle.pem                   # SUSE
  {usr,usr/local,opt/app-root}/lib*/python3*/site-packages/{,pip/_vendor/}certifi/cacert.pem
)
KEYSTORES=(
  etc/pki/ca-trust/extracted/java/cacerts                 # RHEL, UBI
  etc/ssl/certs/java/cacerts                              # Debian, Ubuntu
)

# 1. PEM bundles: rewrite in place without the bad roots.
for f in "${BUNDLES[@]}"; do
  inside "$f" && has_bad "$f" || continue
  clean=$(drop_bad "$f") && [ -n "$clean" ] || continue
  printf '%s\n' "$clean" > "$f" && log "removed bad roots from /$f"
done

# 2. OpenSSL hash directory (Debian, Alpine): delete the entries, including the
#    <hash>.0 links, that resolve to a single bad root.
if [[ $(realpath etc/ssl/certs 2>/dev/null) == "$root"/* ]]; then
  for e in etc/ssl/certs/*; do
    t=$(resolve "$e")
    [ -f "$t" ] && [ "$(grep -c '^-----BEGIN' "$t")" = 1 ] && has_bad "$t" || continue
    rm -f "$e" && log "deleted /$e"
  done
fi

# 3. Java keystores are binary: replace them with the patched copy, if provided.
if [ -f "${RHSB_JAVA_CACERTS:-}" ]; then
  for f in "${KEYSTORES[@]}"; do
    inside "$f" && grep -qaE "$BAD_JAVA" "$f" || continue
    cat "$RHSB_JAVA_CACERTS" > "$f" && log "replaced /$f"
  done
fi

exit 0
